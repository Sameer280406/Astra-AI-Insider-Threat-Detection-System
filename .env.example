# Copy to .env. Generate unique values; do not deploy these placeholders.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
POSTGRES_PASSWORD=replace_with_url_safe_migration_password
APP_DB_PASSWORD=replace_with_url_safe_application_password
ENVIRONMENT=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000"]
SESSION_MINUTES=60
RATE_LIMIT_PER_MINUTE=120
ENABLE_DEMO=true
DEMO_PASSWORD=replace-with-a-strong-demo-password
MODEL_MODE=mock
MODEL_TIMEOUT_SECONDS=10
MODEL_API_KEY=
MODEL_ENDPOINTS={}
ALERT_THRESHOLD=65
ESCALATION_VELOCITY=20
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCORING_ENABLED=false
INTERNAL_INGEST_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
SPARK_MASTER_URL=http://localhost:8080
# Local frontend only. Docker builds connected mode automatically.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
